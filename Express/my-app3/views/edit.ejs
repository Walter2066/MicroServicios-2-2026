<% include('layout', { body: null }) %>
<h2>Editar Producto</h2>
<form action="/edit/<%= producto.Id %>" method="POST">
    <label>Nombre: <input type="text" name="Nombre" value="<%= producto.Nombre %>" required></label><br><br>
    <label>Precio: <input type="number" name="Precio" value="<%= producto.Precio %>" step="0.01" required></label><br><br>
    <label>Stock: <input type="number" name="Stock" value="<%= producto.Stock %>" required></label><br><br>
    
    <button type="submit">Actualizar</button>
</form>
<br>
<a href="/">Volver a la lista</a>